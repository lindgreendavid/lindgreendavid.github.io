---
// A demo for a project page: a visual that plays once when it comes into view and then has its own control (slider, steps, tabs or clickable
// examples), with three short steps of explanation beside it. The page never takes over the scroll. The visual is drawn in the browser by
// demoClient.ts from the data below; without JavaScript the steps read as plain text. The numbers come from the same model code as the tool below.
interface Props {
  kind: "lbo" | "credit" | "pharma" | "ma" | "research";
  heading: string;
  steps: { title: string; text: string }[];
  data: unknown;
  caption?: string;
}
const { kind, heading, steps, data, caption } = Astro.props;
---
<section class="scene" data-scene={kind} aria-labelledby={`scene-${kind}-h`}>
  <div class="scene-stage">
    <div class="wrap scene-grid">
      <div class="scene-copy">
        <h2 id={`scene-${kind}-h`}>{heading}</h2>
        <ol class="scene-steps">
          {steps.map((s) => (
            <li class="scene-step">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <figure class="scene-visual" role="img" aria-label={caption ?? heading}></figure>
    </div>
  </div>
  <script type="application/json" set:html={JSON.stringify(data)}></script>
  <script>
    import "../lib/demoClient";
  </script>
</section>
