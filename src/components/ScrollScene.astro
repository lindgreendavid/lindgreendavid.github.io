---
// A pinned scroll scene for a project page: the visual on one side changes as you scroll while short steps explain what is happening.
// The visual is drawn in the browser by sceneClient.ts from the data below; without JavaScript, or with reduced motion, the steps read as plain text
// and the visual shows its finished state. The numbers come from the same model code as the tool further down the page.
interface Props {
  kind: "lbo" | "credit" | "pharma" | "ma";
  heading: string;
  steps: { title: string; text: string }[];
  data: unknown;
  skipTo: string;
  caption?: string;
  height?: string;
}
const { kind, heading, steps, data, skipTo, caption, height = "260svh" } = Astro.props;
---
<section class="scene" data-scene={kind} aria-labelledby={`scene-${kind}-h`} style={`--scene-h:${height}`}>
  <div class="scene-stage">
    <div class="wrap scene-grid">
      <div class="scene-copy">
        <h2 id={`scene-${kind}-h`}>{heading}</h2>
        <ol class="scene-steps">
          {steps.map((s) => (
            <li class="scene-step">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
        <a class="scene-skip" href={skipTo}>Skip to the tool</a>
      </div>
      <figure class="scene-visual" role="img" aria-label={caption ?? heading}></figure>
    </div>
  </div>
  <script type="application/json" set:html={JSON.stringify(data)}></script>
  <script>
    import "../lib/sceneClient";
  </script>
</section>
