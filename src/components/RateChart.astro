---
// Real data: ECB euro foreign exchange reference rate, USD per EUR, fetched at build time.
// If the request fails the component renders nothing and the hero stays without a chart.
import { layout, fmtDate, pct, W, H, PAD, type Pt } from "../lib/chart";

const url =
  "https://data-api.ecb.europa.eu/service/data/EXR/D.USD.EUR.SP00.A?format=csvdata&detail=dataonly&lastNObservations=260";

let pts: Pt[] = [];
try {
  const res = await fetch(url);
  if (res.ok) {
    const [head, ...lines] = (await res.text()).trim().split(/\r?\n/);
    const cols = head.split(",");
    const ti = cols.indexOf("TIME_PERIOD");
    const vi = cols.indexOf("OBS_VALUE");
    pts = lines
      .map((l) => l.split(","))
      .map((r): Pt => [r[ti], Number(r[vi])])
      .filter(([, v]) => Number.isFinite(v));
  }
} catch {
  pts = [];
}

const ok = pts.length > 60;
const L = ok ? layout(pts) : null;
const first = ok ? pts[0] : null;
const last = ok ? pts[pts.length - 1] : null;
---
{ok && L && first && last && (
  <figure class="rate" data-rate data-pts={JSON.stringify(pts)}>
    <figcaption>
      <span class="rate-title">EUR/USD</span>
      <span class="rate-sub">ECB reference rate</span>
      <span class="rate-range" role="group" aria-label="Time range">
        <button type="button" data-n="22" aria-pressed="false">1M</button>
        <button type="button" data-n="66" aria-pressed="false">3M</button>
        <button type="button" data-n="260" aria-pressed="true">1Y</button>
        <button type="button" data-surface aria-pressed="false" title="Realised volatility by lookback window and date, in 3D" aria-label="3D volatility surface">3D</button>
      </span>
    </figcaption>
    <p class="rate-read" aria-live="polite">
      <strong data-val>{last[1].toFixed(4)}</strong>
      <span data-date>{fmtDate(last[0])}</span>
      <span class="rate-change" data-change>{pct(first[1], last[1])} over the period</span>
    </p>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Line chart of the EUR/USD reference rate from ${fmtDate(first[0])} to ${fmtDate(last[0])}. Latest value ${last[1].toFixed(4)}, ${pct(first[1], last[1])} over the period.`}>
      {L.grid.map((g) => (
        <g data-g>
          <line x1={PAD.l} x2={W - PAD.r} y1={g.y} y2={g.y} class="rate-grid" />
          <text x={W - PAD.r} y={g.y - 5} text-anchor="end" class="rate-axis">{g.label}</text>
        </g>
      ))}
      <path data-area d={L.area} class="rate-area" />
      <path data-line d={L.line} class="rate-line" pathLength="1" />
      <g data-cursor hidden>
        <line data-cx y1={PAD.t} y2={H - PAD.b} class="rate-cross" />
        <circle data-cd r="5" class="rate-dot" />
      </g>
      <circle data-end cx={L.last.x} cy={L.last.y} r="4.5" class="rate-dot" />
    </svg>
    <canvas
      class="rate-surf"
      data-surf
      tabindex="0"
      role="img"
      aria-label="3D surface of EUR/USD realised volatility by lookback window and date. Use the arrow keys to rotate and Home to reset."
    ></canvas>
    <p class="rate-hint">
      <span>Drag or use the arrow keys to rotate.</span>
      <button type="button" data-reset3d>Reset view</button>
    </p>
    <p class="rate-foot">
      <span data-from>{fmtDate(first[0])}</span>
      <span>Source: European Central Bank, fetched when the site is built</span>
    </p>
  </figure>
)}

<script>
  import { layout, fmtDate, pct, W, H, PAD, type Pt } from "../lib/chart";
  import { volSurface, WINDOWS } from "../lib/vol";

  const root = document.querySelector<HTMLElement>("[data-rate]");
  if (root) {
    root.dataset.mode = "line";
    const surfBtn = root.querySelector<HTMLButtonElement>("[data-surface]")!;
    const canvas = root.querySelector<HTMLCanvasElement>("[data-surf]")!;
    const sub = root.querySelector(".rate-sub")!;
    const subLine = sub.textContent;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let surface: ReturnType<typeof import("../lib/surface3d").createSurface> = null;
    let vol: ReturnType<typeof volSurface> | null = null;
    if (!canvas.getContext || !canvas.getContext("2d")) surfBtn.hidden = true;
    const all: Pt[] = JSON.parse(root.dataset.pts!);
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const svg = $<SVGSVGElement>("svg");
    const line = $<SVGPathElement>("[data-line]");
    const area = $<SVGPathElement>("[data-area]");
    const end = $<SVGCircleElement>("[data-end]");
    const cur = $<SVGGElement>("[data-cursor]");
    const cx = $<SVGLineElement>("[data-cx]");
    const cd = $<SVGCircleElement>("[data-cd]");
    const val = $("[data-val]");
    const date = $("[data-date]");
    const change = $("[data-change]");
    const from = $("[data-from]");
    const grids = Array.from(root.querySelectorAll("[data-g]"));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-n]"));
    let pts = all;
    let L = layout(pts);

    const reset = () => {
      const [a, b] = [pts[0], pts[pts.length - 1]];
      cur.setAttribute("hidden", "");
      end.style.opacity = "";
      val.textContent = b[1].toFixed(4);
      date.textContent = fmtDate(b[0]);
      change.textContent = `${pct(a[1], b[1])} over the period`;
    };

    const enterSurface = async () => {
      root.dataset.mode = "surface";
      buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      surfBtn.setAttribute("aria-pressed", "true");
      sub.textContent = "Realised volatility surface";
      vol ??= volSurface(all);
      const row = vol.z[WINDOWS.indexOf(20)];
      const [now, lo, hi] = [row[row.length - 1], Math.min(...row), Math.max(...row)];
      val.textContent = `${now.toFixed(1)}%`;
      date.textContent = `20-day window, ${fmtDate(vol.dates[vol.dates.length - 1])}`;
      change.textContent = `range ${lo.toFixed(1)} to ${hi.toFixed(1)}%`;
      const hint = root.querySelector(".rate-hint span");
      if (hint) hint.textContent = `Height is annualised volatility, ${vol.min.toFixed(0)}% to ${vol.max.toFixed(0)}%. Drag or use the arrow keys to rotate.`;
      canvas.setAttribute(
        "aria-label",
        `3D surface of EUR/USD annualised realised volatility by lookback window (5 to 60 days) and date. Latest 20-day value ${now.toFixed(1)} percent, range ${lo.toFixed(1)} to ${hi.toFixed(1)} percent. Use the arrow keys to rotate and Home to reset.`
      );
      if (!surface) {
        const { createSurface } = await import("../lib/surface3d");
        surface = createSurface(
          canvas,
          {
            z: vol.z,
            min: vol.min,
            max: vol.max,
            xLabels: [fmtDate(vol.dates[0]), fmtDate(vol.dates[vol.dates.length - 1])],
            yLabels: ["5 d", "60 d"],
          },
          reduced
        );
      }
      surface?.show();
    };

    const show = (n: number) => {
      root.dataset.mode = "line";
      surfBtn.setAttribute("aria-pressed", "false");
      sub.textContent = subLine;
      pts = all.slice(-n);
      L = layout(pts);
      line.setAttribute("d", L.line);
      area.setAttribute("d", L.area);
      end.setAttribute("cx", String(L.last.x));
      end.setAttribute("cy", String(L.last.y));
      grids.forEach((g, i) => {
        const [ln, tx] = [g.querySelector("line")!, g.querySelector("text")!];
        ln.setAttribute("y1", String(L.grid[i].y));
        ln.setAttribute("y2", String(L.grid[i].y));
        tx.setAttribute("y", String(L.grid[i].y - 5));
        tx.textContent = L.grid[i].label;
      });
      from.textContent = fmtDate(pts[0][0]);
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.n) === n)));
      // Replay the draw-in so the change of range reads as one gesture.
      line.style.animation = "none";
      void line.getBoundingClientRect();
      line.style.animation = "";
      reset();
    };

    const move = (e: PointerEvent) => {
      const r = svg.getBoundingClientRect();
      const t = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      const i = Math.round(t * (pts.length - 1));
      const x = L.x(i);
      const y = L.y(pts[i][1]);
      cur.removeAttribute("hidden");
      end.style.opacity = "0";
      cx.setAttribute("x1", String(x));
      cx.setAttribute("x2", String(x));
      cd.setAttribute("cx", String(x));
      cd.setAttribute("cy", String(y));
      val.textContent = pts[i][1].toFixed(4);
      date.textContent = fmtDate(pts[i][0]);
      change.textContent = `${pct(pts[0][1], pts[i][1])} since ${fmtDate(pts[0][0])}`;
    };

    svg.addEventListener("pointermove", move);
    svg.addEventListener("pointerleave", reset);
    buttons.forEach((b) => b.addEventListener("click", () => show(Number(b.dataset.n))));
    surfBtn.addEventListener("click", enterSurface);
    root.querySelector("[data-reset3d]")?.addEventListener("click", () => surface?.reset());
  }
</script>
