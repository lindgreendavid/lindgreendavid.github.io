---
import "@fontsource-variable/geist";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: string;
  image?: string; // path of the 1200x630 social image
  type?: string; // Open Graph type
  jsonld?: object[]; // structured data
  noindex?: boolean;
}
const { title, description, lang = "en", image = "/og/home.png", type = "website", jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f7f4" />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <meta name="author" content="David Lindgreen" />
    <meta property="og:site_name" content="David Lindgreen" />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_GB"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Set the theme before first paint: saved choice, else the system setting. Shortcut: without JS the page stays light.
      (function () {
        document.documentElement.classList.add("js"); // controls that only work with JavaScript are hidden without it
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const root = document.documentElement;
      const sync = () => toggle?.setAttribute("aria-label", root.dataset.theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
      sync();
      toggle?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        sync();
      });
    </script>
    <script>
      // Panels tilt a few degrees toward the pointer. Only on devices that can hover, and never with reduced motion.
      if (matchMedia("(hover: hover) and (pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.querySelectorAll<HTMLElement>(".panel").forEach((el) => {
          el.addEventListener("pointermove", (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty("--ry", `${((e.clientX - r.left) / r.width - 0.5) * 6}deg`);
            el.style.setProperty("--rx", `${(0.5 - (e.clientY - r.top) / r.height) * 6}deg`);
          });
          el.addEventListener("pointerleave", () => {
            el.style.removeProperty("--rx");
            el.style.removeProperty("--ry");
          });
        });
      }
    </script>
    <script>
      import "../lib/motion";
    </script>
    <script>
      // Entrances: each marked block rises and fades in once, staggered. Content stays visible if this never runs.
      // Project and note pages mark nothing by hand: their headings, panes, pipelines and uses lists get the same entrance.
      document.querySelectorAll<HTMLElement>("main .section-head, main .pane, main .uses").forEach((el) => el.setAttribute("data-rv", ""));
      document.querySelectorAll<HTMLElement>("main .flow, main .proj-hero").forEach((el) => {
        el.setAttribute("data-rv", "");
        el.setAttribute("data-stagger", "");
      });
      const els = Array.from(document.querySelectorAll<HTMLElement>("[data-rv]"));
      if ("IntersectionObserver" in window && els.length) {
        els.forEach((el) => {
          if (el.hasAttribute("data-stagger")) Array.from(el.children).forEach((c, i) => (c as HTMLElement).style.setProperty("--d", String(i)));
        });
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
        document.documentElement.classList.add("reveal-ready");
      }
    </script>
  </body>
</html>
