---
import Base from "../../layouts/Base.astro";
import ProjectHeader from "../../components/ProjectHeader.astro";
import "../../styles/projects.css";
import ds from "../../data/pharma/dataset.json";
import filings from "../../data/research/filings.json";
import summary from "../../data/research/eval-summary.json";
import devResults from "../../data/research/eval-results.json";

const chips = ["In which jurisdiction is AstraZeneca incorporated?", "Which company had the highest operating margin in 2025?", "What was GSK's net debt including leases at the end of 2025?", "What were Kisqali sales in 2025?", "Should I buy GSK shares?"];
const totalQuestions = summary.sets.reduce((acc, x) => acc + x.v21.questions, 0);
const fmt = (n: number) => n.toLocaleString("en-US");
---
<Base title="Annual-Report Research Assistant | David Lindgreen" description="Ask questions across the FY2025 Form 20-F reports of Novartis, AstraZeneca and GSK. Answers are source passages with links, deterministic calculations or an explicit refusal. First release, evaluated on 142 hand-written questions.">
  <ProjectHeader current="projects" />
  <main id="main">
    <section class="wrap proj-hero">
      <h1>Annual-Report Research Assistant</h1>
      <p class="proj-lede">Ask a question about the FY2025 annual reports of Novartis, AstraZeneca and GSK. You get the source passage with a link into the filing, a calculation shown step by step, or a clear refusal. It does not write answers.</p>
      <p class="status">First release · in development · evaluated, not independently reviewed</p>
      <div class="brief">
        <div><h2>Who it is for</h2><p>An analyst who needs to find what a filing says, quickly, and to check it against the original.</p></div>
        <div><h2>The problem</h2><p>Annual reports run to hundreds of pages. Search finds words, not the right passage, and chat tools can answer fluently without a source.</p></div>
        <div><h2>What it supports</h2><p>Locating evidence and checking figures, with every answer traceable. It is not a buy or sell signal.</p></div>
      </div>
      <nav class="jump" aria-label="On this page"><a href="#ask">Ask</a><a href="#how">How it works</a><a href="#evaluation">Evaluation</a><a href="#documents">Documents</a><a href="#limits">Limits</a></nav>
    </section>

    <section class="wrap" aria-label="Disclosures">
      <p class="callout"><strong>Public documents only.</strong> The corpus is three Forms 20-F from the SEC. No Sanofi or other employer material is used. This was built with AI assistance and the author is responsible for checking it. It is an educational tool, not investment advice. There is no language model in this version: it is a keyword search plus a calculator.</p>
    </section>

    <div class="band band-mint">
      <section class="wrap section" id="ask" aria-labelledby="ask-h">
        <div class="section-head"><h2 id="ask-h">Ask the reports</h2><p>Try a lookup, a calculation, a comparison, or something the reports cannot answer.</p></div>
        <div class="pane">
          <form id="ask-form" class="ask-form" action="#" aria-label="Ask a question">
            <label for="ask-q">Your question</label>
            <div class="ask-row">
              <input id="ask-q" name="q" type="text" autocomplete="off" maxlength="300" placeholder="e.g. In which jurisdiction is AstraZeneca incorporated?" required />
              <button type="submit" class="btn btn-primary">Search</button>
            </div>
          </form>
          <p class="chips-label">Examples</p>
          <div class="chips">{chips.map((c) => <button type="button" class="chip" data-q={c}>{c}</button>)}</div>
          <p id="ask-status" class="muted" role="status"></p>
          <div id="ask-out" aria-live="polite"></div>
          <noscript><p class="callout">This page needs JavaScript to search. The evaluation results below do not.</p></noscript>
        </div>
      </section>
    </div>

    <section class="wrap section" id="how" aria-labelledby="how-h">
      <div class="section-head"><h2 id="how-h">How it works</h2><p>Three separate stages. Each can be tested on its own, and none of them generates text.</p></div>
      <div class="cols-3">
        <div class="pane prose"><h3 style="margin-top:0">1. Scope guard</h3><p>Refuses what annual reports cannot support: investment advice, live prices, forecasts and companies that are not in the corpus. A refusal says why.</p></div>
        <div class="pane prose"><h3 style="margin-top:0">2. Calculation</h3><p>Numerical questions (margins, cash flow, net debt, tax rate, growth, comparisons) are answered by code from the reconciled dataset of the <a href="/projects/pharma-valuation/">valuation project</a>, with the formula shown. Questions about a product or region are not guessed at; they go to search.</p></div>
        <div class="pane prose"><h3 style="margin-top:0">3. Retrieval</h3><p>Everything else is a keyword search over {fmt(Object.values(filings).reduce((a, f) => a + f.passages, 0))} passages cut from the filings. Version 2 stems words (Porter), treats close synonyms from a small hand-written thesaurus and corpus-derived neighbours as the same idea at a discount, and rewards question words that sit together. The top passages are shown as quoted, with a link to that place in the filing. If the best passage lacks the question's key ideas, it refuses and shows the nearest passages so you can judge.</p></div>
      </div>
    </section>

    <div class="band band-mint">
      <section class="wrap section" id="evaluation" aria-labelledby="eval-h">
        <div class="section-head"><h2 id="eval-h">Evaluation</h2><p>{totalQuestions} hand-written questions in five sets, each run on three versions of the engine. Failures are listed, not hidden.</p></div>
        <div class="pane">
          <div class="tbl-wrap" role="region" aria-label="Evaluation results, scrolls horizontally on small screens" tabindex="0">
            <table class="tbl">
              <caption class="sr">Evaluation results by question set and engine version</caption>
              <thead><tr><th scope="col">Question set</th><th scope="col">All correct: v1 → v2 → v2.1</th><th scope="col">Lookup, right passage first</th><th scope="col">Lookup, right passage in top five</th><th scope="col">Lookup, first passage contains the gold answer*</th><th scope="col">Correct refusals</th></tr></thead>
              <tbody>{summary.sets.map((x) => <tr><th scope="row">{x.name}</th><td>{x.v1.overall} → {x.v2.overall} → <strong>{x.v21.overall}</strong></td><td>{x.v1.top1} → {x.v2.top1} → <strong>{x.v21.top1}</strong></td><td>{x.v1.top5} → {x.v2.top5} → <strong>{x.v21.top5}</strong></td><td>{x.v1.answerInTop1} → {x.v2.answerInTop1} → <strong>{x.v21.answerInTop1}</strong></td><td>{x.v1.unanswerable} → {x.v2.unanswerable} → <strong>{x.v21.unanswerable}</strong></td></tr>)}</tbody>
            </table>
          </div>
          <p class="muted" style="margin-top:0.75rem">{summary.note} These columns overlap; they are different views of the same questions, not separate tests to add together. *A word-overlap check of the first passage against the gold answer, added after an external check; it is stricter than the evidence-string test in some cases and looser in others.</p>
          <div class="prose">
            <h3>How to read this</h3>
            <ul>
              <li><strong>Version 2 helps where questions are paraphrased</strong> (set 2: {summary.sets[2].v1.top1} → {summary.sets[2].v2.top1}; set 3: {summary.sets[3].v1.top1} → {summary.sets[3].v2.top1} right passage first) and it is still wrong or silent on about half of such questions. On the original development set it was slightly worse ({summary.sets[0].v1.overall} → {summary.sets[0].v2.overall}).</li>
              <li><strong>Version 2.1 changes only the scope guard</strong> (retrieval is identical to version 2). An external technical check found that "What is the capital of Switzerland?" and "What is 2 plus 2?" retrieved unrelated passages, and that an undated share-price question returned a historical year-end table. Version 2.1 refuses arithmetic, country-geography and general-knowledge questions, and refuses undated share-price and market-value questions with an explanation that only year-end figures exist. Lookup quality did not change.</li>
              <li><strong>Set 4 is the only test written for version 2.1</strong> ({summary.sets[4].v2.overall} → {summary.sets[4].v21.overall}; correct refusals {summary.sets[4].v2.unanswerable} → {summary.sets[4].v21.unanswerable}). It was written by Claude, an AI assistant, on 2026-10-23, before the new guard was run on anything, then run once per engine. It has now been seen, so any further change needs a new set.</li>
              <li><strong>Set 3 is no longer untouched.</strong> It was written before version 2 and run once per engine, but its results have been read by reviewers. Set 2 was used to design version 2. The development set was used to build version 1.</li>
              <li><strong>Independence limitation:</strong> the questions, the gold evidence, the thesaurus and the engine all come from the same AI-assisted process. The author has not reviewed the gold answers. An external technical check reproduced every published result; it did not write any question set.</li>
              <li>Lookup passes only if a passage containing the gold evidence string is first ("top-1") or among the first five ("top-5"). Calculations pass only on an exact match with a value computed separately from the filing figures. Unanswerable questions pass only if the tool refuses.</li>
              <li>The questions and gold answers were written and checked with AI assistance. The author's own check against the filings is pending.</li>
            </ul>
            <h3>Known failures of version 2.1</h3>
            {summary.sets.map((x) => (
              <details class="data"><summary>{x.name}: {x.failuresV21.length} not passed</summary><ul>{x.failuresV21.map((f) => <li><strong>{f.id}</strong> ({f.outcome}): {f.q}</li>)}</ul></details>
            ))}
            <p class="muted">Findings still open: several answerable questions are refused or ranked low when the filing uses different words (a paraphrase needs real language understanding); a question that merely contains the word "will" is refused as a forecast even when it asks about the past or about policy ("how long will a launched product remain useful"); medical-advice questions about topics the reports mention (for example shingles treatment) still return passages; indirect price phrasings such as "how much is a GSK share" are not all caught. Version 2.1's guard is pattern-based and incomplete.</p>
            <h3>What changed in version 1 after its first run</h3>
            <ul>{devResults.changesAfterFirstRun.map((c) => <li>{c}</li>)}</ul>
            <h3>What version 2 changed</h3>
            <ul>
              <li>Porter stemming instead of a hand-rolled suffix rule.</li>
              <li>A hand-written thesaurus of about 100 groups of general business, legal and pharma words, matched at 60% weight, and corpus neighbours (random-indexing co-occurrence) at about 35%, so one idea is never counted twice.</li>
              <li>A bonus for question words that appear next to each other in the passage.</li>
              <li>A stronger scope guard: any "will" question, a year after 2026, "at the moment" or "last night", and questions involving a company that is not covered are refused.</li>
              <li>Refusal thresholds (coverage 0.5, score 6) were chosen on set 2, then frozen before set 3 was run.</li>
            </ul>
          </div>
        </div>
      </section>
    </div>

    <section class="wrap section" id="documents" aria-labelledby="docs-h">
      <div class="section-head"><h2 id="docs-h">Documents and handling</h2><p>Retrieved {ds.generated}. Passages are cut from the filing HTML; page numbers are not used because the SEC HTML has no reliable ones. Links jump to the nearest element in the filing.</p></div>
      <div class="pane">
        <div class="tbl-wrap" role="region" aria-label="Documents searched" tabindex="0">
          <table class="tbl">
            <caption class="sr">Documents searched</caption>
            <thead><tr><th scope="col">Company</th><th scope="col">Form 20-F filed</th><th scope="col">Passages</th><th scope="col">Characters</th><th scope="col">Source</th></tr></thead>
            <tbody>{Object.entries(filings).map(([k, f]) => <tr><th scope="row">{f.name}</th><td>{f.filed}</td><td>{fmt(f.passages)}</td><td>{fmt(f.chars)}</td><td><a href={f.url} rel="noopener noreferrer">{f.accession}</a></td></tr>)}</tbody>
          </table>
        </div>
        <div class="prose">
          <h3>Source and attribution</h3>
          <p>The passages are extracts from Forms 20-F that Novartis AG, AstraZeneca PLC and GSK plc filed publicly with the US SEC; the copyright in that text remains with those companies. They are shown here for non-commercial research and education, with a link to each original filing. If a rights holder objects, write to the address in the <a href="/impressum/">Impressum</a> and the text will be removed.</p>
          <h3>Documents are untrusted input</h3>
          <p>Filing text can contain anything. It is displayed only as plain text, never as HTML or as instructions, and no language model reads it in this version. If a language model is added later, retrieved text will be treated as data, not as commands.</p>
        </div>
      </div>
    </section>

    <div class="band band-mint">
      <section class="wrap section" id="limits" aria-labelledby="lim-h">
        <div class="section-head"><h2 id="lim-h">Limits and next steps</h2></div>
        <div class="cols-2">
          <div class="pane prose">
            <h3 style="margin-top:0">Limits</h3>
            <ul>
              <li>Keyword search with synonyms is not understanding: it still misses many paraphrases (roughly two in three on the blind sets) and can rank a related passage above the right one.</li>
              <li>Only FY2025 Forms 20-F of three companies. Earlier years appear only where the 2025 report repeats them, and the calculator uses the reconciled FY2023 to FY2025 dataset.</li>
              <li>Tables are flattened to text rows; complex tables can lose structure.</li>
              <li>Passage boundaries come from font and bold cues in the HTML, so some section labels are imperfect.</li>
              <li>Small evaluation sets; not independently reviewed.</li>
            </ul>
          </div>
          <div class="pane prose">
            <h3 style="margin-top:0">Next steps</h3>
            <ul>
              <li>Add a real embedding model and compare it with version 2.1; write a new set 5 first, because sets 1 to 4 have all been seen.</li>
              <li>Only then consider a language model, with citations required and the same refusal tests.</li>
              <li>Have another person write and answer a new question set.</li>
              <li>Extend to the FY2024 filings.</li>
            </ul>
          </div>
        </div>
      </section>
    </div>

    <section class="wrap section" id="downloads" aria-labelledby="dl-h">
      <div class="section-head"><h2 id="dl-h">Downloads</h2></div>
      <ul class="downloads">
        <li><a href="/downloads/research-assistant/eval-questions.json" download>Development questions with gold answers (json)</a></li>
        <li><a href="/downloads/research-assistant/eval-results.json" download>Development results (json)</a></li>
        <li><a href="/downloads/research-assistant/eval-heldout-questions.json" download>Held-out questions with gold answers (json)</a></li>
        <li><a href="/downloads/research-assistant/eval-heldout-results.json" download>Held-out set 1 results, version 1 (json)</a></li>
        <li><a href="/downloads/research-assistant/eval-heldout2-questions.json" download>Held-out set 2 questions (json)</a> and <a href="/downloads/research-assistant/eval-heldout3-questions.json" download>blind set 3 questions (json)</a></li>
        <li><a href="/downloads/research-assistant/eval-summary.json" download>Summary of all sets, both versions (json)</a>; per-set results use the names eval-*-results.json</li>
      </ul>
    </section>

    <footer class="wrap proj-foot"><p><a href="/projects/">All projects</a> · David Lindgreen · Frankfurt, Germany</p></footer>
  </main>

  <script>
    import ds from "../../data/pharma/dataset.json";
    import filings from "../../data/research/filings.json";
    import { initResearch } from "../../lib/research/ui.ts";
    initResearch(ds as never, filings as never);
  </script>
</Base>
