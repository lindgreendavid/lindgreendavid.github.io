---
import Base from "../../layouts/Base.astro";
import ProjectHeader from "../../components/ProjectHeader.astro";
import ProjectFlow from "../../components/ProjectFlow.astro";
import ProjectUses from "../../components/ProjectUses.astro";
import "../../styles/projects.css";
import ds from "../../data/ma/dataset.json";
import type { Dataset } from "../../lib/ma/screen.ts";
import { buildTargets, defaultTarget } from "../../lib/lbo/targets.ts";
import { inputsFor, runLbo } from "../../lib/lbo/model.ts";
import { renderLbo, renderMonteCarlo, renderTornado, toFormValues } from "../../lib/lbo/ui.ts";

const data = ds as unknown as Dataset;
// Targets: every company in the screening dataset with the figures an LBO needs. Figures come from the 10-K data (see the M&A project).
const targets = buildTargets(data);
const def = defaultTarget(data, targets);
const inputs = inputsFor(def);
const result = runLbo(inputs);
const x = renderLbo(inputs, result);
const mcHtml = renderMonteCarlo(inputs);
const tnHtml = renderTornado(inputs);
const fv = toFormValues(inputs);
const fld = (v: number) => String(Math.round(v * 100) / 100);
const fmtM = (n: number) => Math.round(n).toLocaleString("en-US");
---
<Base title="LBO Workbench | David Lindgreen" description="A transparent leveraged-buyout model on real SEC figures. Pick a company, set the price and the debt, see the return. Hypothetical deal, educational, not independently reviewed.">
  <ProjectHeader current="projects" />
  <main id="main">
    <section class="wrap proj-hero">
      <h1>LBO Workbench</h1>
      <p class="proj-lede">What could a buyer earn on a listed pharma or biotech company after five years, and where would the return come from? Pick a company, set the price and the debt, and watch the answer move.</p>
      <p class="status">Version 1.0.1 · hypothetical deal · built with AI assistance · not independently reviewed</p>
      <p class="actions-line"><a class="btn btn-primary" href="#model">Run a buyout</a><a class="text-link" href="/projects/lbo-workbench/method/">Read the method note</a></p>
    </section>

    <section class="wrap" aria-label="Disclosures">
      <div class="callout"><p><strong>Hypothetical, for learning.</strong> No company here is for sale, and nothing is a bid, a price target or advice.</p><details class="callout-more"><summary>Full disclosure</summary><p>The company only supplies real starting figures from its 10-K (the same data as the <a href="/projects/ma-screening/">M&amp;A screening project</a>). The price, debt terms and operating assumptions are your inputs, not market data. The author works at Sanofi; no Sanofi or other employer information is used. Built with AI assistance; the author is responsible for checking it.</p></details></div>
    </section>

    <div class="band band-mint" id="model">
      <section class="wrap" style="padding-top: clamp(2.5rem, 6vw, 4.5rem)" aria-label="Workbench" hidden>
        <div class="tabs" role="tablist" aria-label="Workbench sections" hidden>
          <button type="button" role="tab" id="tab-try" aria-controls="panel-try" aria-selected="true">Try it</button>
          <button type="button" role="tab" id="tab-details" aria-controls="panel-details" aria-selected="false" tabindex="-1">Details</button>
          <button type="button" role="tab" id="tab-risk" aria-controls="panel-risk" aria-selected="false" tabindex="-1">How sure is it</button>
          <button type="button" role="tab" id="tab-about" aria-controls="panel-about" aria-selected="false" tabindex="-1">About</button>
        </div>
      </section>

      <div class="tab-panel" id="panel-try" role="tabpanel" aria-labelledby="tab-try">
        <section class="wrap section" aria-labelledby="try-h">
          <div class="section-head"><h2 id="try-h">Run a buyout</h2><p>Pick a company and change the five main assumptions. Everything updates as you type. Amounts are US dollars, millions.</p></div>
          <div class="cols-2" style="align-items: start">
            <form id="lbo-form" class="pane stack" action="#" aria-label="Buyout assumptions" onsubmit="return false">
              <div>
              <h3 class="sub-h">Target and deal</h3>
              <div class="field">
                <label for="target">Company (real figures, hypothetical deal)</label>
                <select id="target" name="target">
                  {targets.map((t) => <option value={t.ticker} selected={t.ticker === def.ticker}>{t.name} ({t.ticker})</option>)}
                </select>
              </div>
              <div id="lbo-target" style="margin-top:0.75rem"><p class="muted">FY2025 from the company's 10-K: revenue ${fmtM(def.revenue)}m, EBITDA ${fmtM(def.ebitda)}m (operating income plus depreciation and amortisation), D&amp;A {((def.da / def.revenue) * 100).toFixed(1)}% of revenue, {def.netDebt < 0 ? `net cash $${fmtM(-def.netDebt)}m` : `net debt $${fmtM(def.netDebt)}m`}.</p>{def.flags.length > 0 && <details class="flags"><summary>{def.flags.length} data flag{def.flags.length > 1 ? "s" : ""} for this company</summary><ul>{def.flags.map((f) => <li>{f}</li>)}</ul></details>}</div>
            </div>
              <div class="fields">
                <div class="field"><label for="entry">Entry multiple (EV / EBITDA)</label><input id="entry" name="entry" type="number" inputmode="decimal" step="0.1" value={fld(fv.entry)} /><span class="hint">Your assumption, not a market price</span></div>
                <div class="field"><label for="exit">Exit multiple</label><input id="exit" name="exit" type="number" inputmode="decimal" step="0.1" value={fld(fv.exit)} /></div>
                <div class="field"><label for="senior">Senior debt (x EBITDA)</label><input id="senior" name="senior" type="number" inputmode="decimal" step="0.1" value={fld(fv.senior)} /></div>
                <div class="field"><label for="margin">EBITDA margin in year 5 (%)</label><input id="margin" name="margin" type="number" inputmode="decimal" step="0.1" value={fld(fv.margin)} /><span class="hint">Moves in a straight line from today's</span></div>
              </div>
              <details class="more-fields">
                <summary>All other assumptions</summary>
                <div class="fields">
                  <div class="field"><label for="sub">Subordinated debt (x EBITDA)</label><input id="sub" name="sub" type="number" inputmode="decimal" step="0.1" value={fld(fv.sub)} /></div>
                  <div class="field"><label for="srate">Senior interest rate (%)</label><input id="srate" name="srate" type="number" inputmode="decimal" step="0.1" value={fld(fv.srate)} /></div>
                  <div class="field"><label for="brate">Subordinated interest rate (%)</label><input id="brate" name="brate" type="number" inputmode="decimal" step="0.1" value={fld(fv.brate)} /></div>
                  <div class="field"><label for="amort">Mandatory repayment (% of senior a year)</label><input id="amort" name="amort" type="number" inputmode="decimal" step="0.1" value={fld(fv.amort)} /></div>
                  <div class="field"><label for="sweep">Cash sweep (% of excess cash)</label><input id="sweep" name="sweep" type="number" inputmode="decimal" step="1" value={fld(fv.sweep)} /></div>
                  <div class="field"><label for="fee">Fees (% of enterprise value)</label><input id="fee" name="fee" type="number" inputmode="decimal" step="0.1" value={fld(fv.fee)} /></div>
                  <div class="field"><label for="capex">Capex (% of revenue)</label><input id="capex" name="capex" type="number" inputmode="decimal" step="0.1" value={fld(fv.capex)} /></div>
                  <div class="field"><label for="nwc">Working capital (% of revenue growth)</label><input id="nwc" name="nwc" type="number" inputmode="decimal" step="1" value={fld(fv.nwc)} /></div>
                  <div class="field"><label for="tax">Tax rate (%)</label><input id="tax" name="tax" type="number" inputmode="decimal" step="0.1" value={fld(fv.tax)} /><span class="hint">Federal statutory rate; no state tax</span></div>
                </div>
                <fieldset style="border:0;margin:1rem 0 0;padding:0">
                  <legend class="sub-note" style="margin-bottom:0.5rem">Revenue growth, years 1 to 5 (%)</legend>
                  <div class="fields">
                    {[1, 2, 3, 4, 5].map((n) => (
                      <div class="field"><label for={`g${n}`}>Year {n}</label><input id={`g${n}`} name={`g${n}`} type="number" inputmode="decimal" step="0.1" value={fld(fv[`g${n}` as "g1"])} /></div>
                    ))}
                  </div>
                </fieldset>
              </details>
              <button type="button" id="lbo-reset" class="btn-quiet">Reset to the defaults for this company</button>
            </form>
            <div class="stack" aria-live="polite">
              <div class="pane">
                <p id="lbo-error" class="error" role="alert" hidden></p>
                <div id="lbo-big"><Fragment set:html={x.big} /></div>
                <div id="lbo-flags" style="margin-top: 1rem"><Fragment set:html={x.flags} /></div>
              </div>
            <div class="pane"><h3 class="sub-h">Where the return comes from</h3><p class="sub-note">Equity invested, plus what each driver added, equals equity at exit. Dollars, millions.</p><div id="lbo-bridge"><Fragment set:html={x.bridge} /></div></div>
            </div>
          </div>
        <div class="pane surf3d-pane" id="lbo-3d" hidden style="margin-top: 1.25rem">
          <h3 class="sub-h">The return as a landscape</h3>
          <p class="sub-note">The same grid as the first table, wider and smoother: sponsor IRR for every entry and exit multiple around your inputs. A high ridge is where the return is large; the slope shows how fast it falls when the price paid goes up or the price at sale goes down. Drag to turn it.</p>
          <canvas class="surf3d" tabindex="0" role="img" aria-label="3D surface of the sponsor IRR by entry multiple and exit multiple."></canvas>
          <p class="surf3d-hint"><span>Drag or use the arrow keys to rotate.</span><button type="button" data-reset3d>Reset view</button></p>
        </div>
        </section>
      </div>

      <div class="tab-panel" id="panel-details" role="tabpanel" aria-labelledby="tab-details">
        <section class="wrap section" aria-labelledby="details-h">
          <div class="section-head"><h2 id="details-h">Details</h2><p>The full numbers behind the result: the deal, the five-year plan and how the return changes with price, debt and margin.</p></div>
          <div class="cols-2" style="align-items: start">
            <div class="pane"><h3 class="sub-h">Returns to the sponsor</h3><div id="lbo-summary"><Fragment set:html={x.summary} /></div></div>
          <div class="pane"><h3 class="sub-h">Sources and uses</h3><div id="lbo-su" class="tbl-wrap" role="region" aria-label="Sources and uses, scrolls horizontally on small screens" tabindex="0"><Fragment set:html={x.su} /></div></div>
          </div>
          <div style="margin-top: 1.25rem">
          <div class="pane"><h3 class="sub-h">Debt by year</h3><p class="sub-note">Senior and subordinated debt outstanding. The figure above each column is net debt divided by EBITDA.</p>
              <div class="legend" aria-hidden="true"><span class="y1">Senior</span><span class="y0">Subordinated</span></div>
              <div id="lbo-debt"><Fragment set:html={x.debt} /></div></div>
          </div>
        <div class="pane" style="margin-top: 1.25rem"><h3 class="sub-h">Projection and debt schedule</h3><div id="lbo-years" class="tbl-wrap" role="region" aria-label="Projection and debt schedule, scrolls horizontally on small screens" tabindex="0"><Fragment set:html={x.years} /></div></div>
          <div class="cols-2" style="margin-top: 1.25rem; align-items: start">
          <div class="pane"><div id="sens1" class="tbl-wrap"><Fragment set:html={x.sens1} /></div></div>
          <div class="pane"><div id="sens2" class="tbl-wrap"><Fragment set:html={x.sens2} /></div></div>
        </div>
          <p class="muted" style="margin-top: 0.75rem">The outlined cell marks the current inputs. A cell reads n/a where the inputs are not valid, for example when the debt is larger than the price.</p>
        </section>
      </div>

      <div class="tab-panel" id="panel-risk" role="tabpanel" aria-labelledby="tab-risk">
        <section class="wrap section" aria-labelledby="risk-h">
          <div class="section-head"><h2 id="risk-h">How sure is it</h2><p>A single return hides how much it depends on things nobody can know. These show the range and the assumption that matters most.</p></div>
          <div class="cols-2" style="align-items: start">
          <div class="pane"><h3 class="sub-h">How uncertain is the return?</h3><p class="sub-note">3,000 simulated cases (fixed seed, so the numbers repeat). Revenue growth, the year-5 margin, the exit multiple and the senior interest rate vary around your inputs; the price and the debt multiples do not. The spreads are illustrative assumptions, not estimates from data (see Method).</p><div id="lbo-mc"><Fragment set:html={mcHtml} /></div></div>
          <div class="pane"><h3 class="sub-h">Which input matters most?</h3><p class="sub-note">One input at a time, everything else at your values. The longest bar is the input the return depends on most.</p><div id="lbo-tornado"><Fragment set:html={tnHtml} /></div></div>
          </div>
        </section>
      </div>
    </div>

    <div class="tab-panel" id="panel-about" role="tabpanel" aria-labelledby="tab-about">
      <section class="wrap section" aria-labelledby="about-h">
        <div class="section-head"><h2 id="about-h">About and method</h2><p>What this is, how it is built and what it cannot tell you. The short version: <a href="/projects/lbo-workbench/method/">the method note</a>.</p></div>
        <div class="brief">
          <div><h2>Who it is for</h2><p>An analyst or student who wants to see how a buyout works, not just the result: how much debt, how fast it is repaid and what drives the return.</p></div>
          <div><h2>The problem</h2><p>Buyout returns depend on a handful of assumptions, and a single IRR hides which one matters. A good model shows the funding, the debt schedule and the sensitivities.</p></div>
          <div><h2>What it supports</h2><p>Understanding the mechanics of an LBO and testing how fragile a return is. It is not a bid, a valuation or a view on any company.</p></div>
        </div>
      </section>
    <ProjectFlow id="built" heading="How it is built" intro="The same five steps a first-pass LBO follows, each one shown on this page." steps={[
      { title: "Starting figures", detail: "Revenue, EBITDA, depreciation and net debt for FY2025, from the company's 10-K via SEC XBRL data." },
      { title: "Deal", detail: "You set the entry multiple and the debt. The equity cheque is whatever is left to fund the price and the fees." },
      { title: "Five-year plan", detail: "Growth, margin, capex, working capital and tax produce the cash flow that is left after interest." },
      { title: "Debt schedule", detail: "Mandatory repayment, then a cash sweep. Interest is charged on opening balances." },
      { title: "Exit and return", detail: "Sell at an exit multiple, repay what is owed, and the rest is the sponsor's equity: MOIC and IRR." },
    ]} />

    <section class="wrap section" id="read" aria-labelledby="read-h">
      <div class="section-head"><h2 id="read-h">How to read it</h2></div>
      <div class="prose">
        <h3>Three sources of return</h3>
        <p>A buyout earns money in only three ways. The company's earnings grow, so the same multiple is applied to more EBITDA. The multiple changes between entry and exit. Or cash flow pays down debt, so a larger share of the enterprise value belongs to the equity. The waterfall shows how much each contributed in the case you set, plus the fees that were paid to do the deal.</p>
        <h3>Why leverage cuts both ways</h3>
        <p>Borrowing more shrinks the equity cheque, which raises the return if the business earns more than the debt costs. The second grid shows the other side: with high debt and a weaker margin, the return falls faster, and in the worst cells the equity is worth nothing. Interest cover in the schedule shows how close to the edge a case is.</p>
        <h3>The exit multiple does a lot of work</h3>
        <p>Setting the exit multiple equal to the entry multiple is the conventional, cautious choice. The first grid shows how much a turn of multiple matters. If most of a return comes from a higher exit multiple, that is a bet on the market, not on the business.</p>
      </div>
    </section>

    <div class="band band-mint">
      <section class="wrap section" id="method" aria-labelledby="method-h">
        <div class="section-head"><h2 id="method-h">Method</h2></div>
        <div class="prose">
          <ul>
            <li><strong>Starting figures.</strong> FY2025 revenue, operating income, depreciation and amortisation, debt, cash and short-term investments from the company's 10-K (SEC XBRL, plus balance-sheet debt read from the filing for a few companies; see the <a href="/projects/ma-screening/#evidence">M&amp;A evidence</a>). EBITDA is operating income plus depreciation and amortisation, as reported, with no adjustments. Royalty-financing obligations count as debt, as in the screen.</li>
            <li><strong>Funding.</strong> Enterprise value is the entry multiple times EBITDA. Uses are the enterprise value plus fees. Sources are the senior and subordinated debt you set, as multiples of EBITDA, and the sponsor equity is the remainder. The company's existing net debt is repaid out of the enterprise value, so it does not change the price, but it sets the equity purchase price shown in the table.</li>
            <li><strong>Plan.</strong> Revenue grows at the rates you set. EBITDA margin moves in a straight line to the year-5 margin. D&amp;A is the company's FY2025 share of revenue. Capex is a share of revenue and working-capital investment is a share of the growth in revenue. Tax is charged on EBIT less interest, never below zero.</li>
            <li><strong>Debt.</strong> Interest is charged on opening balances, which avoids a circular calculation. The senior debt has a mandatory repayment (a share of the original amount) and a cash sweep of the excess; the subordinated debt is repaid at exit. Cash that is not swept builds up on the balance sheet and counts at exit.</li>
            <li><strong>Return.</strong> Exit enterprise value is the exit multiple times year-5 EBITDA. Equity at exit is that less net debt. MOIC is exit equity divided by the equity invested; IRR is MOIC to the power of one fifth, less one, because there are no interim payments.</li>
            <li><strong>Uncertainty.</strong> A Monte Carlo of 3,000 cases with a fixed seed: revenue growth shifts by a common amount (normal, standard deviation 3 points) plus year noise (2 points), the year-5 margin varies (normal, 3 points), the exit multiple is triangular within 2 turns of your input and the senior rate varies (normal, 1 point). The price, debt multiples and fees are deal terms and stay fixed. The spreads are my illustrative choices, so the output shows how wide the outcomes can be, not their true probabilities. The tornado moves one input at a time by a stated amount.</li>
            <li><strong>Checks.</strong> {" "}20 unit tests cover the funding identity, a closed-form case, the bridge identity, the debt schedule, validation, the sensitivity grids, the reproducibility of the simulation and the tornado. The Excel file is recalculated in Excel and compared with this page.</li>
          </ul>
        </div>
      </section>
    </div>

    <ProjectUses id="uses" heading="What it is for, and what it taught" intro="The LBO is the standard test of whether someone understands how value, debt and cash flow fit together."
      uses={[
        { where: "Private equity", how: "Funds use an LBO to test what price they can pay for a target and still reach their return, and how much debt the business can carry." },
        { where: "Investment banking", how: "Sell-side and leveraged-finance teams build the same model to show a buyer's ability to pay and to size the debt a deal can support." },
        { where: "Corporate finance and credit", how: "Lenders look at the same schedule: leverage, interest cover and how fast debt is repaid under a downside case." },
        { where: "Learning finance", how: "Changing one input at a time shows which assumptions matter and which are noise, which is the point of a sensitivity grid." },
      ]}
      learned={[
        { lesson: "The returns come from three places, and one of them is a bet.", evidence: "The bridge separates earnings growth, multiple change and debt paydown, so a return that depends on a higher exit multiple is visible as such." },
        { lesson: "Debt makes outcomes wider, not better.", evidence: "More leverage raised the return in the base case and wiped out the equity in a weak case, which the second grid shows side by side." },
        { lesson: "A model should explain itself.", evidence: "Sources equal uses, the bridge adds up to the gain, and the tests prove both, so a wrong number cannot hide in a total." },
        { lesson: "Public data stops short of a real LBO.", evidence: "There is no capex or loan terms in the data used, so those are stated assumptions, not facts." },
      ]} />

    <section class="wrap section" id="limits" aria-labelledby="lim-h">
      <div class="section-head"><h2 id="lim-h">Limits</h2></div>
      <div class="prose">
        <ul>
          <li><strong>It is hypothetical.</strong> The entry price, exit multiple, loan terms and operating assumptions are yours or illustrative defaults. They are not market data, and the defaults are not a view on what any company is worth.</li>
          <li><strong>The starting EBITDA is as reported.</strong> It includes one-offs, stock compensation and acquisition effects unless the data flags say otherwise; a real model would adjust it. The default company is chosen because it has no identified one-offs, not because it is a good target.</li>
          <li><strong>The financing is simplified.</strong> One senior tranche, one subordinated tranche, no revolver, no minimum cash, no interest-deductibility limit, no fees amortised, no management equity, no dividends, no purchase-price accounting and no transaction-specific tax structure.</li>
          <li><strong>A funding gap is flagged, not financed.</strong> If cash goes negative in a year, nothing pays for the shortfall in the model, so the return shown with that warning is conditional on financing that is not modelled. The simulation reports those cases separately. If the equity is wiped out, the sponsor receives zero, not a negative amount.</li>
          <li><strong>Capex and loan terms are assumptions.</strong> The filings supply neither as inputs for this model, so capex is a share of revenue you set. Interest rates are illustrative, and rates change with the market.</li>
          <li><strong>Pharma and biotech are not typical buyout targets.</strong> Patent expiries, pipeline risk and regulation make cash flows less predictable than the model assumes, which is a reason to read the sensitivity grids rather than the single IRR.</li>
          <li><strong>Not independently reviewed.</strong> It was built with AI assistance, checked by tests and an Excel recalculation, and has not been reviewed by a finance professional. Educational use only; not investment advice.</li>
        </ul>
      </div>
    </section>

    <div class="band band-mint">
      <section class="wrap section" id="downloads" aria-labelledby="dl-h">
        <div class="section-head"><h2 id="dl-h">Downloads</h2><p>The Excel model uses live formulas for the funding, projection, debt schedule and returns, with a checks sheet. It is set up for the default company above.</p></div>
        <ul class="downloads">
          <li><a href="/downloads/lbo-workbench/lbo-model.xlsx" download>LBO model with live formulas (xlsx)</a></li>
        </ul>
      </section>
    </div>

    </div>

    <footer class="wrap proj-foot"><p><a href="/projects/">All projects</a> · David Lindgreen · Frankfurt, Germany</p></footer>
  </main>

  <script>
    import { initLbo } from "../../lib/lbo/ui.ts";
    const el = document.getElementById("lbo-targets");
    if (el) initLbo(JSON.parse(el.textContent ?? "[]"));

    // Tabs: without JavaScript every panel is shown one after another and the tab bar stays hidden.
    const list = document.querySelector<HTMLElement>('[role="tablist"]');
    if (list) {
      const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls")!)!);
      const select = (i: number, focus = false) => {
        tabs.forEach((t, k) => {
          t.setAttribute("aria-selected", String(k === i));
          t.tabIndex = k === i ? 0 : -1;
          panels[k].hidden = k !== i;
        });
        if (focus) tabs[i].focus();
        window.dispatchEvent(new Event("resize")); // the 3D view and charts re-measure when their panel appears
      };
      list.hidden = false;
      list.parentElement!.hidden = false;
      select(0);
      tabs.forEach((t, i) => {
        t.addEventListener("click", () => select(i));
        t.addEventListener("keydown", (e) => {
          const k = e.key;
          const next = k === "ArrowRight" ? (i + 1) % tabs.length : k === "ArrowLeft" ? (i + tabs.length - 1) % tabs.length : k === "Home" ? 0 : k === "End" ? tabs.length - 1 : -1;
          if (next < 0) return;
          e.preventDefault();
          select(next, true);
        });
      });
      const hash = location.hash.replace("#", "");
      const byHash = ["try", "details", "risk", "about"].indexOf(hash.replace("tab-", ""));
      if (byHash > 0) select(byHash);
    }
  </script>
  <script type="application/json" id="lbo-targets" set:html={JSON.stringify(targets)}></script>
</Base>
