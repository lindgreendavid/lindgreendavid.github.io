---
import Base from "../layouts/Base.astro";
import RateChart from "../components/RateChart.astro";
import LegalLinks from "../components/LegalLinks.astro";
import MiniBars from "../components/MiniBars.astro";
import { person, notes, roles, next } from "../data/site";
import { evalRows, marginRows, top5Rows } from "../lib/projectViz.ts";

const [lead, second, third] = notes;
const more = notes.slice(3);
const arrow = "M3 8h9M8.5 4l4 4-4 4";

const work = roles.filter((r) => r.org === "Sanofi" || (r.org === "Le Wagon" && r.role.startsWith("Lead")));
const education = roles.filter((r) => !work.includes(r) && r.role !== "Teaching assistant");
---
<Base
  title="David Lindgreen: data and AI, building towards finance"
  description="David Lindgreen is a data and AI analyst in Frankfurt, working with large operational datasets at Sanofi and publishing analyses with their limits stated. Building towards finance."
>
  <a class="skip" href="#work">Skip to the work</a>

  <header class="bar">
    <a class="mark" href="#top">David Lindgreen</a>
    <nav class="nav" aria-label="Sections">
      <a href="#work">Work</a>
      <a href="/projects/">Projects</a>
      <a href="#experience">Experience</a>
      <a href="#next">Next</a>
      <button class="theme" type="button" aria-label="Switch to dark theme" data-theme-toggle>
        <svg class="moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" /></svg>
        <svg class="sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <a href="#contact" class="nav-cta">Get in touch</a>
    </nav>
  </header>

  <main id="top">
    <section class="wrap hero">
      <h1 class="display">
        <span class="ln"><span>Complex data,</span></span>
        <span class="ln"><span>clear decisions.</span></span>
      </h1>
      <div class="hero-row">
        <div class="hero-copy">
          <p class="hero-sub">Dual student at Sanofi, teacher at Le Wagon, building towards finance.</p>
          <div class="actions">
            <a class="btn btn-primary" href={`mailto:${person.email}`}>Email me</a>
            <a class="text-link" href={person.linkedin} rel="noopener">LinkedIn<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a>
          </div>
          <p class="hero-meta">Frankfurt, Germany. Open to opportunities worldwide.</p>
        </div>
        <div class="hero-chart">
          <RateChart />
          <p class="hero-chart-note">
            The same ECB data feed that my <a href="#work">Data Contract Observatory</a> monitors.
          </p>
        </div>
      </div>
    </section>

    <section class="wrap pillars" aria-label="What I do" data-rv data-stagger>
      <div>
        <h2>Operational analytics</h2>
        <p>Power BI dashboards on large machine datasets in Snowflake, built at Sanofi for management and their teams.</p>
      </div>
      <div>
        <h2>Rigorous analysis</h2>
        <p>Twelve public analyses with code, data and their limits stated, from responsible AI to data observability.</p>
      </div>
      <div>
        <h2>Teaching</h2>
        <p>Lead Teacher at Le Wagon: SQL, Python and analytics for 100+ students.</p>
      </div>
    </section>

    <section class="wrap section section-tight" id="projects" aria-labelledby="projects-h">
      <div class="section-head" data-rv>
        <h2 id="projects-h">Finance projects on public filings</h2>
        <p>Three connected tools, each drawn from real data and checked against the source. First releases, built with AI assistance, not independently reviewed.</p>
      </div>
      <div class="proj-trio" data-rv data-stagger>
        <div>
          <h3>Pharma Valuation Explorer</h3>
          <p class="trio-for">Compares Novartis, AstraZeneca and GSK on one basis, then values AstraZeneca with a DCF.</p>
          <MiniBars title="Operating margin, FY2025" rows={marginRows} />
          <p class="links"><a href="/projects/pharma-valuation/">Open the explorer<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a></p>
        </div>
        <div>
          <h3>Annual-Report Research Assistant</h3>
          <p class="trio-for">Answers questions from the filings with a source link, a calculation or a refusal. No language model.</p>
          <MiniBars title="Questions answered correctly" rows={evalRows} />
          <p class="links"><a href="/projects/research-assistant/">Open the assistant<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a></p>
        </div>
        <div>
          <h3>M&amp;A Screening Workbench</h3>
          <p class="trio-for">Ranks 28 pharma and biotech companies for a hypothetical buyer and shows how fragile the order is.</p>
          <MiniBars title="Top five, score 0 to 100" rows={top5Rows} />
          <p class="links"><a href="/projects/ma-screening/">Open the workbench<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a></p>
        </div>
      </div>
    </section>

    <div class="band band-mint">
      <section class="wrap section" id="work" aria-labelledby="work-h">
        <div class="section-head" data-rv>
          <h2 id="work-h">Selected work</h2>
          <p>Three analyses closest to data and AI work in finance. Each links to the write-up and the code.</p>
        </div>

        <div class="work" data-rv data-stagger>
          <article class="panel panel-ink work-lead">
            <div>
              <h3>{lead.name}</h3>
              <p class="panel-field">{lead.field}</p>
            </div>
            <div>
              <p class="panel-headline">{lead.headline}</p>
              <p class="panel-summary">{lead.summary}</p>
              <p class="links">
                <a href={lead.note} rel="noopener">Read the note<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a>
                <a href={lead.repo} rel="noopener">Code<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a>
                {lead.live && <a href={lead.live} rel="noopener">Interactive lab<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a>}
              </p>
            </div>
          </article>

          <article class="panel panel-paper work-second">
            <h3>{second.name}</h3>
            <p class="panel-field">{second.field}</p>
            <p class="panel-headline">{second.headline}</p>
            <p class="panel-summary">{second.summary}</p>
            <p class="links">
              <a href={second.note} rel="noopener">Read the note<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a>
              <a href={second.repo} rel="noopener">Code<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a>
            </p>
          </article>

          <article class="panel panel-paper work-third">
            <div>
              <h3>{third.name}</h3>
              <p class="panel-field">{third.field}</p>
            </div>
            <div>
              <p class="panel-headline">{third.headline}</p>
              <p class="panel-summary">{third.summary}</p>
              <p class="links">
                <a href={third.note} rel="noopener">Read the note<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a>
                <a href={third.repo} rel="noopener">Code<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a>
                {third.live && <a href={third.live} rel="noopener">Interactive lab<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} /></svg></a>}
              </p>
            </div>
          </article>
        </div>

        <details class="more" data-rv>
          <summary>
            <span>Nine more analyses</span>
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 6l5 5 5-5" /></svg>
          </summary>
          <ul class="more-list">
            {more.map((n) => (
              <li>
                <a href={n.note} rel="noopener">
                  <span class="more-name">{n.name}</span>
                  <span class="more-field">{n.field}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="more-foot">
            All write-ups are on <a href={person.labNotes} rel="noopener">Lab Notes</a>; the code is on <a href={person.github} rel="noopener">GitHub</a>.
          </p>
        </details>
      </section>
    </div>

    <section class="wrap section" id="experience" aria-labelledby="exp-h">
      <div class="section-head" data-rv>
        <h2 id="exp-h">Experience</h2>
      </div>
      <ul class="timeline" data-rv data-stagger>
        {work.map((r) => (
          <li class="t-item">
            <p class="t-dates">{r.dates}</p>
            <div>
              <h3>{r.org}<span>{r.role}</span></h3>
              <ul class="t-points">
                {r.points.slice(0, 4).map((p) => <li>{p}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>

      <div class="edu" data-rv data-stagger>
        {education.map((r) => (
          <div>
            <p class="t-dates">{r.dates}</p>
            <h3>{r.org}</h3>
            <p>{r.role}</p>
          </div>
        ))}
      </div>

    </section>

    <section class="wrap section section-tight" id="tools" aria-labelledby="tools-h">
      <div class="section-head" data-rv>
        <h2 id="tools-h">Tools I work with</h2>
        <p>Each group comes with what I have actually done with it.</p>
      </div>
      <div class="skills" data-rv data-stagger>
        <div>
          <h3>Data</h3>
          <p class="skill-tools"><span>Power BI</span> · <span>Snowflake</span> · <span>Excel</span> · <span>Power Platform</span></p>
          <p>10+ dashboards used by about 50 people at Sanofi, on machine data recorded every 1 to 2 seconds.</p>
        </div>
        <div>
          <h3>Code</h3>
          <p class="skill-tools">SQL · Python</p>
          <p>Taught to 100+ students at Le Wagon, and used in the analyses on Lab Notes.</p>
        </div>
        <div>
          <h3>Build</h3>
          <p class="skill-tools"><span>TypeScript</span> · <span>Rust and WebAssembly</span></p>
          <p>Interactive labs for my public analyses, including a Rust and WebAssembly numerical lab.</p>
        </div>
      </div>
      <ul class="langs" data-rv aria-label="Languages">
        <li><strong>German</strong><span>Native</span></li>
        <li><strong>English</strong><span>Full professional</span></li>
        <li><strong>Spanish</strong><span>Basic</span></li>
        <li><strong>French</strong><span>Basic</span></li>
      </ul>
    </section>

    <section class="wrap section" id="next" aria-labelledby="next-h">
      <div class="section-head" data-rv>
        <h2 id="next-h">Where I'm heading</h2>
        <p>Finance is the next chapter. Statuses below are stated plainly: planned, first release, or completed.</p>
      </div>
      <ul class="next" data-rv data-stagger>
        {next.map((n) => (
          <li>
            <div>
              <h3>{n.name}</h3>
              <p>{n.points}</p>
            </div>
            <span class="pill">{n.status}</span>
          </li>
        ))}
      </ul>
    </section>

    <div class="band band-ink" id="contact">
      <section class="wrap contact" aria-labelledby="contact-h">
        <h2 id="contact-h" data-rv>Let's talk.</h2>
        <p class="contact-lede" data-rv>If you hire for data, AI or finance analytics, or want to compare notes, write to me.</p>
        <p class="contact-mail" data-rv><a href={`mailto:${person.email}`}>{person.email}</a></p>
        <p class="contact-links" data-rv>
          <a href={person.linkedin} rel="noopener">LinkedIn</a>
          <a href={person.github} rel="noopener">GitHub</a>
          <a href={person.labNotes} rel="noopener">Lab Notes</a>
        </p>
      </section>
      <footer class="wrap foot">
        <p class="wordmark" aria-hidden="true">David Lindgreen</p>
        <div class="foot-row">
          <p class="foot-line">{person.location}</p>
          <LegalLinks />
        </div>
      </footer>
    </div>
  </main>
</Base>
